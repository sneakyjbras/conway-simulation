*.o
*.obj
*.lo
*.la
*.a
*.lib
*.so
*.so.*
*.dylib
*.dll
*.exe
*.out
*.app
*.i*      # preprocessed files
*.s       # assembly outputs
*.su
*.pdb
*.idb
*.ilk
*.exp
*.map

