
# --- OS junk ---
.DS_Store
Thumbs.db

# --- Editors/IDEs ---
.vscode/
.idea/
*.code-workspace

# clangd / ccls caches
.clangd/
.ccls-cache/

# --- Python virtualenvs (if you test scripts) ---
.venv/
venv/

# --- Build directories (out-of-source CMake builds) ---
/build/
/build-* /cmake-build-*/

# --- CMake generated files (if someone builds in-tree by mistake) ---
CMakeCache.txt
CMakeFiles/
CMakeScripts/
Testing/
Makefile
cmake_install.cmake
install_manifest.txt
CTestTestfile.cmake

# Ninja/Make artifacts
.ninja_deps
.ninja_log

